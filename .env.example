# GitHub OAuth2 – kopiere nach .env und fülle die Werte aus
# .env wird von IntelliJ geladen (Run Configuration → EnvFile)

CLIENT_ID=
CLIENT_SECRET=

# Optional: GitHub-numerische IDs mit Admin-Rechten (kommagetrennt, z.B. 12345678,87654321)
ADMIN_IDS=

# Optional: In dev aktivieren für ?testUser=1001–1005 auf Betreuer-Seite (default: false)
TEST_USER_ENABLED=false
